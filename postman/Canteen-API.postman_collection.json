    {
      "name": "02-Create",
      "item": [
        {
          "name": "TC08 create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/menu-items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu-items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"{{itemName}}\", \"category\": \"an_vat\", \"price\": 15000}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"itemName\", \"Món thử \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const item = pm.response.json();",
                  "pm.test(\"Có header Location đúng\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/menu-items/\" + item.id);",
                  "});",
                  "pm.test(\"Mặc định available = true\", () => pm.expect(item.available).to.be.true);",
                  "pm.collectionVariables.set(\"itemId\", item.id);"
                ]
              }
            }
          ]
        }
      ]
    },
