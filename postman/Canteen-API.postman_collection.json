    {
      "name": "05-Data-driven",
      "item": [
        {
          "name": "DD negative POST",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/menu-items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu-items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"{{name}}\", \"category\": \"{{category}}\", \"price\": {{price}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.iterationData.get(\"case\");",
                  "const expected = Number(pm.iterationData.get(\"expected\"));",
                  "pm.test(`[${c}] trả về ${expected}`, () => {",
                  "  pm.response.to.have.status(expected);",
                  "});"
                ]
              }
            }
          ]
        }
