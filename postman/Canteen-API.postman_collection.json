        {
          "name": "TC01 health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status = ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC02 list all",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu-items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu-items"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Có 4 món mẫu\", () => pm.expect(pm.response.json()).to.have.lengthOf(4));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC03 filter bun_pho sort price desc",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu-items?category=bun_pho&sort=price&order=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu-items"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "bun_pho"
                },
                {
                  "key": "sort",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "desc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const items = pm.response.json();",
                  "pm.test(\"Chỉ có món bun_pho\", () => {",
                  "  items.forEach(i => pm.expect(i.category).to.eql(\"bun_pho\"));",
                  "});",
                  "pm.test(\"Giá giảm dần\", () => {",
                  "  for (let k = 1; k < items.length; k++)",
                  "    pm.expect(items[k - 1].price).to.be.at.least(items[k].price);",
                  "});"
                ]
              }
            }
          ]
        },
